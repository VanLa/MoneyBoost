<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="MoneyBoost SDK 测试"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="浅红=未加载  浅绿=展示中"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_ad_load_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:text="广告加载状态"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_collapsible_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Show CollapsibleBanner" />

        <Button
            android:id="@+id/btn_interstitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Show Inter" />

        <Button
            android:id="@+id/btn_rewarded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Show Rewarded" />

        <Button
            android:id="@+id/btn_hide_collapsible_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide CollapsibleBanner" />

    </LinearLayout>
</ScrollView>
