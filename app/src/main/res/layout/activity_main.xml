<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="120dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="MoneyBoost SDK 测试"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="浅红=未加载  浅绿=展示中"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_ad_load_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:text="广告加载状态"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView android:id="@+id/tv_native_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="Native: auto preload after initialization / splash" />
        <Button android:id="@+id/btn_load_native_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Load Native Home" />
        <Button android:id="@+id/btn_show_native_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Native Home" />
        <Button android:id="@+id/btn_load_native_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Load Native Action" />
        <Button android:id="@+id/btn_show_native_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Native Action" />
        <Button android:id="@+id/btn_load_native_album" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Load Native Album" />
        <Button android:id="@+id/btn_show_native_album" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show Native Album" />
        <Button android:id="@+id/btn_hide_native" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hide Native (keep loaded)" />
        <Button android:id="@+id/btn_destroy_native" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Destroy Native (pause auto load)" />
        <FrameLayout android:id="@+id/native_demo_slot" android:layout_width="match_parent" android:layout_height="224dp"
            android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:background="#EEEAF8" />
        <Button
            android:id="@+id/btn_collapsible_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Show CollapsibleBanner" />

        <Button
            android:id="@+id/btn_interstitial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Show Inter" />

        <Button
            android:id="@+id/btn_rewarded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Show Rewarded" />

        <Button
            android:id="@+id/btn_hide_collapsible_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide CollapsibleBanner" />

    </LinearLayout>
</ScrollView>
