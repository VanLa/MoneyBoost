<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/laughtale_rounded_top_bg">

    <!-- close_area 保持在顶部，并且默认隐藏 -->
    <RelativeLayout
        android:id="@+id/close_area"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:visibility="gone"
        android:gravity="top|left">
        <Button
            android:id="@+id/laughtale_close_btn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            android:layout_marginTop="9dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/laughtale_ic_arrow_down" />
    </RelativeLayout>

    <!-- content_area 保持在底部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/laughtale_mod_close_btn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:visibility="gone"
                android:layout_marginTop="9dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/laughtale_ic_arrow_down_full" />

            <FrameLayout
                android:id="@+id/laughtale_media_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/laughtale_inters_title"
                android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="1"
            android:gravity="center"
            android:lines="1"
            android:text="Dream"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/laughtale_inters_icon_img"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="12dp" />

            <TextView
                android:id="@+id/laughtale_inters_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="6dp"
                android:layout_toLeftOf="@id/laughtale_inters_click_btn"
                android:layout_toRightOf="@id/laughtale_inters_icon_img"
                android:gravity="left"
                android:text="Dream"
                android:textColor="#FFA1A1A1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/laughtale_inters_click_btn"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="3dp"
                android:background="@drawable/laughtale_btn_circle"
                android:gravity="center"
                android:text="Go"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="17dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="5dp"
                android:gravity="right"
                android:text="AD"
                android:textAlignment="viewStart"
                android:textColor="#000000"
                android:textSize="14sp" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
