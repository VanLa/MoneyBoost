<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景渐变色 -->
    <gradient
        android:startColor="#00CD59"
    android:endColor="#008C40"
    android:angle="45" />

    <!-- 圆角 -->
    <corners android:radius="31dp" />

    <!-- 阴影效果 -->
    <solid android:color="#00CD59" />  <!-- 背景绿色，保持一致 -->

    <!-- 增强的阴影效果 -->
    <padding
        android:left="5dp"
    android:top="5dp"
    android:right="5dp"
    android:bottom="5dp" />
</shape>
